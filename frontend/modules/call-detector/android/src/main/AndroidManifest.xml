<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    READ_PHONE_STATE alone reports that the phone is ringing but redacts the number:
    since Android 9 (API 28) EXTRA_INCOMING_NUMBER is only populated for receivers
    holding READ_CALL_LOG as well. POST_NOTIFICATIONS is required from Android 13.
    All three are runtime permissions — the manifest only makes them requestable.

    Declared here rather than in the app's AndroidManifest because frontend/android/ is
    prebuild output and gitignored: a permission added there would exist on one machine
    only. The manifest merger folds this into the app manifest at build time.
  -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!--
      Manifest-declared, not runtime-registered, so it still fires once the app's process
      has been reclaimed — the usual state when a call comes in. ACTION_PHONE_STATE_CHANGED
      is on Android's implicit-broadcast exemption list, so this is still delivered on
      API 26+.

      The name must be fully qualified: a leading-dot name in a library manifest would be
      resolved against the *app's* package during the merge, not this module's.
    -->
    <receiver
      android:name="com.cardn.calldetector.IncomingCallReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PHONE_STATE" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
