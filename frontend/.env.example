# Copy to .env.local (gitignored) before building for a physical device.
#
# The default in src/shared/api/client.ts is 10.0.2.2, the Android *emulator's* alias for
# the host machine, which does not resolve on a real phone. A physical device has to
# reach the dev machine over the LAN, so set the host machine's LAN IP here — `ipconfig`
# on Windows, `ifconfig` elsewhere — and make sure the phone is on the same Wi-Fi and the
# backend is reachable on port 8000 (docker-compose already publishes it; Windows Firewall
# may still need to allow the inbound connection).
#
# EXPO_PUBLIC_* is inlined into the JS bundle at build time, so Metro has to be restarted
# after changing this — a running dev server will keep serving the old value.
#
# Two names because the codebase reads two: EXPO_PUBLIC_API_URL in shared/api/client.ts
# (contacts, conversations, call-alert) and EXPO_PUBLIC_API_BASE_URL in
# features/graph/api/graphApi.ts.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8000/api/v1
