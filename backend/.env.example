# Host view (running the backend outside Docker). A containerized backend
# (once backend/Dockerfile exists) would instead use mysql:3306 — the
# compose service name and its internal port.
DATABASE_URL=mysql+asyncmy://cardn:cardn@localhost:3307/cardn_db

# Fernet key for the encrypted PII columns (phone / email / address). Required - the app
# refuses to start without it, on purpose: the old default was a key committed to this
# repository, which is not a key at all.
#
# The value below is that old one. Keep it for local work and your existing database stays
# readable. Do NOT use it anywhere reachable from outside your machine - it is in the git
# history, so anything it protects is public.
#
# For a deployment, generate a fresh one and keep it out of the repo:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes existing rows unreadable; there is no re-encryption path yet.
FIELD_ENCRYPTION_KEY=1wRKRifwXl3jxdEAg17HwBdimFbahjl5OX6_aTjxWUc=

# Browsers allowed to call this API, comma-separated. Only the Expo web preview needs it
# - the Android app is not a browser. Leave empty otherwise, including in production.
#   CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CORS_ORIGINS=

# Conversation feature — Whisper STT (app/features/conversation/stt.py).
# Keep the whole team on the same model: transcripts differ between model sizes, and a
# misheard name is a relationship edge that silently never gets created (the summary's
# mentioned_people is matched against contact names — see features/graph/conversation_sync.py).
# First run downloads ~1.6GB to the HuggingFace cache and takes a while; it is cached after that.
# With a GPU: WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Load the model at server startup instead of on the first /transcribe. The download is
# cached, but each new process still loads ~1.6GB into memory, and whoever sends the
# first request waits for it. Warming up moves that wait to startup rather than
# removing it, so set this false while developing with `uvicorn --reload` — there every
# save restarts the process and pays it again.
WHISPER_WARMUP=true

# Conversation summaries. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
